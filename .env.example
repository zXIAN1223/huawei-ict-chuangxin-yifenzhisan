# AI 辅助学习助手 —— 环境变量示例
# 用法：复制本文件为 .env 并按需填写。.env 及 .env.*（本文件除外）均已被 .gitignore 忽略。
# 安全约定：本文件仅包含占位符，禁止在此写入任何真实密钥，也禁止把真实 .env 提交到版本库。

# ---------------------------------------------------------------------------
# 1) 数据持久化
# ---------------------------------------------------------------------------
# SQLite 数据库文件路径。相对路径基于仓库根目录解析；默认 backend/app/data/app.db
ALA_DB_PATH=backend/app/data/app.db

# ---------------------------------------------------------------------------
# 2) 大模型接口 LLM_*（任意 OpenAI 兼容端点）
#    端点或密钥任一为空时，问答服务自动回退本地规则化模拟（provider="local"）。
# ---------------------------------------------------------------------------
# 接口地址。两种写法均可：
#   - base 形式：https://api.deepseek.com/v1   -> 自动补全为 .../v1/chat/completions
#   - 完整 endpoint：https://api.deepseek.com/v1/chat/completions -> 原样使用
# 注意：地址需自带版本前缀（如 /v1）；系统不会自动补 /v1，缺前缀可能返回 404。
LLM_BASE_URL=
# API 密钥（仅从进程环境变量或本文件读取；切勿硬编码、打印或提交到版本库）
LLM_API_KEY=
# 模型名称（按服务商填写，如 deepseek-chat / gpt-4o-mini；留空回退默认值 pangu）
LLM_MODEL=
# 请求超时（秒）。非法数值回退默认 30
LLM_TIMEOUT=30
# 采样温度，取值 [0.0, 2.0]；非法值回退默认 0.7
LLM_TEMPERATURE=0.7
# 单次生成最大 token；非法值或 <1 回退默认 1024
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# 3) 兼容别名 PANGU_*（可选，仅为兼容旧部署保留）
#    优先级：LLM_* 优先于 PANGU_*。仅当对应 LLM_* 键未设置（或为空）时，
#    才回退读取同义 PANGU_* 键；因此只填 PANGU_API_URL / PANGU_API_KEY 仍可工作。
# ---------------------------------------------------------------------------
# 旧名：等价于 LLM_BASE_URL
PANGU_API_URL=
# 旧名：等价于 LLM_API_KEY
PANGU_API_KEY=
# 旧名：等价于 LLM_MODEL
PANGU_MODEL=pangu
# 旧名：等价于 LLM_TIMEOUT
PANGU_TIMEOUT=30

# ---------------------------------------------------------------------------
# 4) 离线语音识别 ASR_*（Vosk，可选；语音输入主通道）
#    未安装 vosk 依赖、ASR_ENABLED=false 或模型目录不存在时，前端自动降级为
#    浏览器原生语音识别（Web Speech API），聊天主流程不受影响。
# ---------------------------------------------------------------------------
# 是否启用后端 ASR：1/true/yes/on 启用；0/false/no/off 关闭；其它值视为启用
ASR_ENABLED=true
# 中文小模型目录（相对路径基于仓库根目录解析为绝对路径）
# 模型下载（首次使用，约 42MB，离线识别 16kHz 单声道 WAV）：
#   python scripts/download_asr_model.py            # 已存在则跳过，不会重复下载
#   python scripts/download_asr_model.py --force    # 重新下载并替换
#   python scripts/download_asr_model.py --model-dir <绝对路径>   # 自定义安装位置
# 手动方式：从 https://alphacephei.com/vosk/models 下载 vosk-model-small-cn-0.22.zip，
#   解压到下面的目录，使其中直接包含 am/ conf/ graph/ 等子目录。
# 注意：模型文件体积大，不得提交到版本库——.gitignore 已忽略 backend/app/data/vosk/。
ASR_MODEL_DIR=backend/app/data/vosk/vosk-model-small-cn-0.22
# 识别语言
ASR_LANG=zh-CN
# 单次识别调用超时（秒）；非法值回退默认 30
ASR_TIMEOUT=30
# 单次录音最大时长（毫秒）；非法值或 <1000 回退默认 60000
ASR_MAX_DURATION_MS=60000
# 单次上传最大字节数（默认 10MB = 10485760）；非法值或 <1024 回退默认值
ASR_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# 5) 服务启动（可选，run.py 读取）
# ---------------------------------------------------------------------------
ALA_HOST=127.0.0.1
ALA_PORT=8000